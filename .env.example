# ═══════════════════════════════════════════════════════════════
# 环境变量样例 —— 复制为 .env 再改
# ═══════════════════════════════════════════════════════════════
#
# ⭐ 重要：**大部分配置不用在这里改。**
#    容器起来后打开看板 → 设置 → 系统设置，代理 / TMDB / Emby / CMS /
#    存储路径 / 下载开关 / 企微推送 / 登录认证 全在那里，保存即生效。
#
#    这个文件只用于「想让容器一启动就带上值」的场景（例如批量部署、
#    或者你不想让别人从面板看到密钥）。
#
#    优先级：看板面板 > 这里的变量 > 代码默认值
#    ⇒ 面板里存过一次，这里的值就被盖住；想回到这里，面板里填 `-` 清掉。
#
# ⚠️ .env 已被 .gitignore 排除，绝不要提交真实密钥。
# ═══════════════════════════════════════════════════════════════

# ── 服务 ──────────────────────────────────────────────────────
PORT=8848
HOST=0.0.0.0
LOG_LEVEL=info

# ── 数据库 ────────────────────────────────────────────────────
# ⚠️ 铁律：禁止落在 /vol02（cifs/fuse 不支持 POSIX 文件锁，会损坏数据库）
# 容器内默认 /app/data/hifan.db（compose 已把 ./data 挂成 /app/data）
DB_PATH=/app/data/hifan.db

# ── 访问认证（公网反代时必填）────────────────────────────────
# 不填 = 不启用登录（内网模式，SunPanel 卡片点开直接看）
# 填了 = 公网访问必须登录，局域网直连（192.168.x.x:8848）仍免登录
HIFAN_USER=
HIFAN_PASS=
# session cookie 名与有效期（一般不用改）
HIFAN_COOKIE=hifan_session
HIFAN_SESSION_TTL_MS=604800000

# ═══════════════════════════════════════════════════════════════
# 以下全部「可选」—— 都可以在设置页里配，留空即可
# ═══════════════════════════════════════════════════════════════

# ── 代理 ──────────────────────────────────────────────────────
# 大陆网络访问 TMDB / hanime 需要；容器内访问宿主机代理用 host.docker.internal
TMDB_PROXY=
HANIME_PROXY=
DL_PROXY=
# FlareSolverr（抓链接/签名重抓用）
# 自建：docker run -d -p 28191:8191 ghcr.io/flaresolverr/flaresolverr
FLARESOLVERR=

# ── TMDB ──────────────────────────────────────────────────────
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_RATE_LIMIT_MS=250
TMDB_MAX_RETRIES=3
# 里番 keyword（采集器用；实测确认值，通常无需改）
TMDB_HENTAI_KEYWORD_ID=198385

# ── 扫描（严格只读）──────────────────────────────────────────
# 容器内路径，对应 compose 的 /library 挂载
SCAN_LIBRARY_ROOT=/library/CloudDrive/影视/影视资源/大电影/里番
# 防递归进云挂载 —— 不要删
SCAN_EXCLUDE_DIRS=CloudDrive,115网盘挂载,@eaDir
SCAN_CROSS_DEVICE=false

# ── 媒体库 / 下载落盘 ────────────────────────────────────────
# 刮削入库的落点（容器内），同样是 /library 挂载下
SCRAPE_LIBRARY_ROOT=/library/CloudDrive/影视/影视资源/大电影/里番
# CMS 生成的 strm 库（可选；用于验证文件真的落盘了）；留空 = 不验证
SCRAPE_STRM_ROOT=
# 下载落盘（容器内），对应 compose 的 /downloads 挂载；⛔ 必须是本地盘
DL_ROOT=/downloads
DL_SUBDIR=待整理
# 直连优先（实测直连成功率 83%，不耗机场流量）
DL_DIRECT_FIRST=true
# 磁盘剩余空间下限（GB）—— 低于就自动停下载队列
DL_MIN_FREE_GB=20
DL_MAX_ATTEMPTS=2

# ── 入库行为 ─────────────────────────────────────────────────
SCRAPE_MAX_ATTEMPTS=3
# 复制「无进展」超时（毫秒），⛔ 不是单集总时长
SCRAPE_COPY_STALL_MS=300000
SCRAPE_EMBY_REFRESH=true
# ⚠️ 只在真要挪库/推倒重来时开 —— 见面板里的警告
SCRAPE_ALLOW_NEW_ROOT=false

# ── Emby（「扫 Emby」/ 入库后刷新）───────────────────────────
# API Key 在 Emby 控制台 → 高级 → API 密钥
EMBY_BASE=
EMBY_API_KEY=
EMBY_LIB_ID=
# 必须是 admin 账号的 uid，否则扫出来的是「假 0」
EMBY_ADMIN_UID=

# ── CMS / cloud-media-sync（入库第二步生成 strm）─────────────
# 账号 = CMS 容器的 ADMIN_USERNAME / ADMIN_PASSWORD
CMS_BASE_URL=
CMS_USER=
CMS_PASS=
CMS_AUTO_SYNC=true
# 入库通知过滤器的访问 token；Emby webhook URL 里带的 token 必须与之一致
CMS_FILTER_TOKEN=hifan-filter
# 过滤后转发到哪（留空用内置默认）
CMS_WEBHOOK_URL=
# 命中这些路径的入库通知剥掉图片（逗号分隔）
CMS_NSFW_PATHS=/里番/,/日本av/

# ── 企业微信推送 ─────────────────────────────────────────────
WECOM_ENABLED=true
# 宿主侧转发器（scripts/wecom_relay.py）
WECOM_RELAY_URL=
WECOM_RELAY_TOKEN=

# ── 调度 ──────────────────────────────────────────────────────
# 定时任务不在这里配 —— 看板 → 设置 → 更新扫描 · 定时（存 data/scheduler.json）
