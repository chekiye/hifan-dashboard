# 环境变量样例 —— 复制为 .env 并填入真实值
# ⚠️ .env 已被 .gitignore 排除，绝不要提交真实密钥

# ── 服务 ──────────────────────────────────────────────────────
PORT=8848
HOST=0.0.0.0
LOG_LEVEL=info

# ── 数据库 ────────────────────────────────────────────────────
# ⚠️ 铁律：禁止落在 /vol02（cifs/fuse 不支持 POSIX 文件锁，会损坏数据库）
# 开发：本地相对路径
DB_PATH=./data/dashboard.db
# 生产（NAS）：必须落本地卷
# DB_PATH=/your/local/dir/data/dashboard.db

# ── TMDB ──────────────────────────────────────────────────────
TMDB_API_KEY=
# 实测大陆直连 api.themoviedb.org 超时，必须走代理
# Docker 内访问宿主机代理：http://host.docker.internal:7890
TMDB_PROXY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_RATE_LIMIT_MS=250
TMDB_MAX_RETRIES=3
# 里番 keyword —— 实测确认值，通常无需修改
TMDB_HENTAI_KEYWORD_ID=198385

# ── NAS 扫描（严格只读） ─────────────────────────────────────
SCAN_LIBRARY_ROOT=/library/媒体目录
# 防递归进云挂载 —— 不要删
SCAN_EXCLUDE_DIRS=CloudDrive,115网盘挂载,@eaDir
SCAN_CROSS_DEVICE=false

# ── 定时任务 ──────────────────────────────────────────────────
CRON_FULL_REFRESH=0 3 * * 0
CRON_NEW_ITEMS=0 4 * * *
CRON_SCAN_LOCAL=0 5 * * *
# ── 登录认证（公网经 Lucky 反代访问时必需） ────────────────────
# ⚠️ 不填 = 完全不启用登录（内网模式，SunPanel 卡片点开直接看）
#    填了 = 公网访问必须登录，局域网直连（局域网IP:8848）仍然免登录
# 🔴 密码只写在这里，绝不写进 docker-compose.yml 或代码库
HIFAN_USER=
HIFAN_PASS=
# session cookie 名与有效期（一般不用改）
HIFAN_COOKIE=hifan_session
HIFAN_SESSION_TTL_MS=604800000

# ── 连接类（可选！）─────────────────────────────────────────
# ⭐ §157：以下全部可以在启动后于「看板 → 设置 → 系统设置」里填，
#    保存即生效、不用重启。这里给的是「想让容器一启动就带值」的写法。
#    留空 = 首次启动后去面板填。

# 代理（大陆网络必填其一，否则 TMDB/hanime 抓不到）
# 容器内访问宿主机代理用 http://host.docker.internal:7890
TMDB_PROXY=
HANIME_PROXY=
DL_PROXY=
# FlareSolverr（抓链接/签名重抓用；自建：docker run -d -p 28191:8191 ghcr.io/flaresolverr/flaresolverr）
# 容器内访问宿主机上的 FlareSolverr 用 http://172.20.0.1:28191/v1
FLARESOLVERR=

# Emby（「扫 Emby」/入库后刷新用；API Key 在 Emby 控制台 → 高级 → API 密钥）
EMBY_BASE=
EMBY_API_KEY=
EMBY_LIB_ID=
# 必须是 admin 账号的 uid，否则扫出来的是「假 0」
EMBY_ADMIN_UID=

# CMS / cloud-media-sync（入库第二步生成 strm；账号 = CMS 容器的 ADMIN_USERNAME/PASSWORD）
CMS_BASE_URL=
CMS_USER=
CMS_PASS=
# 入库通知过滤器（/api/emby/webhook-filter）的访问 token；留空 = 不校验（内网工具可留空）
CMS_FILTER_TOKEN=

# 企业微信推送转发器（不搭转发器就留空 = 不推送）
WECOM_RELAY_URL=
WECOM_RELAY_TOKEN=

